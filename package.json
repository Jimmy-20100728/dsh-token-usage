{
  "name": "dsh-token-usage",
  "version": "1.2.0",
  "description": "Token 用量分析：导入 DeepSeek 官方导出 ZIP / 通用 CSV / JSON，本地解析并可视化费用趋势、缓存命中、模型与 API Key 对比。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "patches",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "billing",
    "cost"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jimmy-20100728/dsh-token-usage.git"
  },
  "homepage": "https://github.com/Jimmy-20100728/dsh-token-usage#readme",
  "bugs": {
    "url": "https://github.com/Jimmy-20100728/dsh-token-usage/issues"
  },
  "license": "MIT"
}
